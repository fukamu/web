---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pathFor } from '../data/routes.ts';
import { site, type Locale } from '../data/site.ts';
import { getMessages } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getMessages(locale);
---

<SiteLayout
  locale={locale}
  routeKey="contact"
  title={copy.meta.contact.title}
  description={copy.meta.contact.description}
>
  <article class="page-article">
    <header class="page-header content-shell reading-width">
      <p class="eyebrow">Contact</p>
      <h1>{copy.nav.contact}</h1>
      <p class="lead">
        {
          locale === 'ja'
            ? 'FUKAMU株式会社へのご連絡は、メールで受け付けます。'
            : 'FUKAMU株式会社 accepts inquiries by email.'
        }
      </p>
    </header>

    <div class="content-shell reading-width article-sections">
      <section aria-labelledby="email-title">
        <h2 id="email-title">{locale === 'ja' ? 'メール' : 'Email'}</h2>
        {
          site.company.publicEmail ? (
            <p class="contact-address">
              <a class="action-link" href={`mailto:${site.company.publicEmail}`}>
                {site.company.publicEmail}
              </a>
            </p>
          ) : (
            <p>
              {locale === 'ja'
                ? '公開用メールアドレスの確認後、読める表記とメール起動リンクを掲載します。'
                : 'The readable address and email link will be added after the public email address is verified.'}
            </p>
          )
        }
        <p class="secondary-text">
          {
            locale === 'ja'
              ? '電話窓口や返信期限は設けていません。製品の利用者向け窓口は、各製品の正式案内をご確認ください。'
              : 'We do not offer a telephone contact or promise a response time. Product support details will be provided with each official product offering.'
          }
        </p>
      </section>

      <section aria-labelledby="privacy-guide-title">
        <h2 id="privacy-guide-title">{locale === 'ja' ? '送信前に' : 'Before writing'}</h2>
        <p>
          {
            locale === 'ja'
              ? 'メールでお送りいただく情報の取扱いは、プライバシー・アクセス解析をご確認ください。'
              : 'Please review our privacy and analytics information before sending personal information by email.'
          }
        </p>
        <a class="text-link" href={pathFor(locale, 'privacy')}>{copy.footer.privacy}</a>
      </section>
    </div>
  </article>
</SiteLayout>
